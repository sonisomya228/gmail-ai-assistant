{
    "manifest_version": 3,

    "name": "Gmail AI Assistant",

    "version": "1.0",

    "description": "AI powered Gmail email assistant",

    "permissions": [
        "activeTab"
    ],

    "host_permissions": [
        "http://localhost:8080/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}